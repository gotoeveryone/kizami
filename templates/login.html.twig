{% extends "layout/base.html.twig" %}

{% block title %}Kizami - ログイン{% endblock %}

{% block body %}
    <h1>ログイン</h1>

    {% if error %}
        <article class="notice-error">{{ error }}</article>
    {% endif %}

    {% if notice %}
        <article>{{ notice }}</article>
    {% endif %}

    <a href="/auth/google" role="button">Google でログイン</a>
{% endblock %}
